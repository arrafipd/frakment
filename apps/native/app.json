{
  "expo": {
    "name": "Frakment Native",
    "slug": "frakment-native",
    "version": "0.0.0",
    "orientation": "portrait",
    "scheme": "frakment",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
