{
  "rewrites": [
    {
      "source": "/.well-known/:path*",
      "destination": "/frakment/.well-known/:path*"
    },
    {
      "source": "/llms.txt",
      "destination": "/frakment/llms.txt"
    },
    {
      "source": "/llms-full.txt",
      "destination": "/frakment/llms-full.txt"
    },
    {
      "source": "/llms.md/:path*",
      "destination": "/frakment/llms.md/:path*"
    },
    {
      "source": "/robots.txt",
      "destination": "/frakment/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/frakment/sitemap.xml"
    },
    {
      "source": "/rss.xml",
      "destination": "/frakment/rss.xml"
    },
    {
      "source": "/openapi.json",
      "destination": "/frakment/openapi.json"
    },
    {
      "source": "/manifest.webmanifest",
      "destination": "/frakment/manifest.webmanifest"
    },
    {
      "source": "/r/:path*",
      "destination": "/frakment/r/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/frakment/api/:path*"
    },
    {
      "source": "/docs/:path*",
      "destination": "/frakment/docs/:path*"
    },
    {
      "source": "/docs",
      "destination": "/frakment/docs"
    },
    {
      "source": "/skills/:path*",
      "destination": "/frakment/skills/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/frakment",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "frakment.vercel.app"
        }
      ],
      "destination": "https://www.arrafi.dev/frakment/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/r/:path*",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, HEAD, OPTIONS"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  }
}
