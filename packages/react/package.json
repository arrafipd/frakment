{
  "name": "@frakment/react",
  "version": "0.0.1",
  "description": "React primitives for Frakment AI and chat interfaces",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanshapd/frakment.git",
    "directory": "packages/react"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "hanshapd (https://github.com/hanshapd)",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./message-scroller": {
      "types": "./dist/message-scroller/index.d.ts",
      "import": "./dist/message-scroller/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && node ../../node_modules/typescript/bin/tsc --emitDeclarationOnly --declaration --outDir dist --rootDir src --incremental false",
    "dev": "tsup --watch"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsup": "^8.5.0",
    "typescript": "5.7.3"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  }
}
