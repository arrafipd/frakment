{
  "name": "frakment",
  "version": "2.0.1",
  "description": "MIT-licensed CLI and design system for the Frakment component registry",
  "keywords": [
    "components",
    "frakment",
    "monochrome",
    "registry",
    "tailwindcss"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arrafipd/frakment.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": "The Frakment Authors (https://github.com/arrafipd/frakment)",
  "type": "module",
  "bin": {
    "frakment": "./dist/bin/index.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/copy-runtime-package.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chalk": "^6.0.1",
    "commander": "^15.1.0",
    "execa": "^10.2.1",
    "ora": "^10.0.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/prompts": "^2.4.9",
    "@types/react": "19.3.0",
    "clsx": "^2.1.1",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "tailwind-merge": "^3.7.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
