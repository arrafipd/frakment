{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core"],
  "files": {
    "includes": [
      "!**/node_modules",
      "!scripts",
      "!**/scripts",
      "!**/dist",
      "!**/.next",
      "!**/.source",
      "!**/.turbo",
      "!**/*.tsbuildinfo",
      "!**/.github",
      "!**/.cursor",
      "!**/.changeset",
      "!**/public/r",
      "!**/public/skills",
      "!mdx-components.tsx",
      "!**/mdx-components.tsx",
      "!**/lib/questionnaire"
    ]
  },
  "linter": {
    "rules": {
      "style": {
        "noIncrementDecrement": "off",
        "useConsistentMethodSignatures": "off",
        "noNestedTernary": "off",
        "noExportedImports": "off",
        "useNamedCaptureGroup": "off",
        "useUnicodeRegex": "off",
        "useDestructuring": "off",
        "useDomQuerySelector": "off",
        "noDescendingSpecificity": "off"
      },
      "performance": {
        "useTopLevelRegex": "off",
        "noJsxPropsBind": "off",
        "noNamespaceImport": "off",
        "noBarrelFile": "off",
        "noAwaitInLoops": "off"
      },
      "complexity": {
        "noForEach": "off",
        "noExcessiveCognitiveComplexity": "off",
        "noVoid": "off",
        "noRedundantDefaultExport": "off"
      },
      "suspicious": {
        "useBaseline": "off",
        "useAwait": "off",
        "noShadow": "off",
        "noEmptySource": "off",
        "noUnnecessaryConditions": "off",
        "noEmptyBlockStatements": "off",
        "noEvolvingTypes": "off",
        "useIterableCallbackReturn": "off",
        "noAssignInExpressions": "off",
        "noDuplicateSelectors": "off",
        "noDocumentCookie": "off",
        "noDuplicateDependencies": "off"
      },
      "correctness": {
        "useImageSize": "off",
        "noUnusedFunctionParameters": "off",
        "noUndeclaredDependencies": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off"
      },
      "a11y": {
        "noSvgWithoutTitle": "off",
        "noNoninteractiveElementInteractions": "off",
        "noStaticElementInteractions": "off",
        "useAriaPropsSupportedByRole": "off",
        "noRedundantRoles": "off",
        "noLabelWithoutControl": "off",
        "useSemanticElements": "off",
        "useKeyWithClickEvents": "off",
        "useValidAnchor": "off"
      }
    }
  }
}
