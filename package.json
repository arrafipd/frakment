{
  "name": "@frakment/site",
  "version": "0.0.1",
  "private": true,
  "description": "Composable and accessible UI primitives for React and React Native with motion built in, customizable styling and AI-ready tooling.",
  "license": "MIT",
  "author": "The Frakment Authors (https://github.com/frakment/ui)",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "assets:generate": "node scripts/workspaces.ts assets:generate @frakment/web",
    "assets:install": "node scripts/workspaces.ts assets:install @frakment/web",
    "prebuild": "node scripts/workspaces.ts build",
    "build": "node scripts/workspaces.ts build @frakment/web",
    "changeset": "changeset",
    "precheck": "node scripts/workspaces.ts build",
    "check": "ultracite check",
    "predev": "node scripts/workspaces.ts build",
    "dev": "node scripts/workspaces.ts dev @frakment/web",
    "docs:audit:claims": "doclify-guardrail check apps/web/content/docs README.md --site-root apps/web/content --exclude CONTRIBUTING.md --format compact --all",
    "docs:audit:context": "context-drift check --root . --config config/context-drift.config.ts --strict",
    "docs:audit:data": "node tooling/docs/audit-data.ts",
    "docs:audit:prose": "textlint --config config/textlint.json \"apps/web/content/docs/**/*.mdx\" README.md",
    "fix": "ultracite fix",
    "prepare": "node scripts/install-hooks.ts",
    "registry:audit": "node scripts/workspaces.ts registry:audit @frakment/web @frakment/native",
    "registry:build": "node scripts/workspaces.ts registry:build @frakment/web @frakment/native",
    "registry:count": "node scripts/component-count.ts",
    "registry:validate": "node scripts/workspaces.ts registry:validate @frakment/web",
    "release": "node scripts/workspaces.ts build && changeset publish",
    "start": "node scripts/workspaces.ts start @frakment/web",
    "pretest": "node scripts/workspaces.ts build",
    "test": "node scripts/workspaces.ts test @frakment/web && vitest run --config config/vitest.packages.config.ts",
    "test:watch": "node scripts/workspaces.ts test:watch @frakment/web",
    "tooling:typecheck": "tsc --noEmit -p tooling/tsconfig.json",
    "pretypecheck": "node scripts/workspaces.ts build",
    "typecheck": "tsc --noEmit -p tooling/tsconfig.json && node scripts/workspaces.ts typecheck frakment @frakment/web @frakment/native",
    "version:packages": "changeset version"
  },
  "overrides": {
    "deepmerge": "npm:@stackline/deepmerge@^1.1.0",
    "esbuild": "^0.28.1",
    "fumadocs-core": "16.19.4",
    "lightningcss": "1.33.0",
    "minimatch": "^11.0.1",
    "textlint": {
      "glob": "14.0.6"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@basedkoala/context-drift": "0.2.0",
    "@biomejs/biome": "^2.6.9",
    "@changesets/cli": "^3.0.3",
    "@mdx-js/mdx": "3.1.1",
    "@types/node": "^26.6.7",
    "doclify-guardrail": "2.0.3",
    "lefthook": "^2.2.2",
    "lightningcss": "1.33.0",
    "playwright": "^1.65.1",
    "textlint": "16.1.3",
    "textlint-plugin-mdx": "1.1.0",
    "textlint-rule-common-misspellings": "1.0.1",
    "typescript": "^5.9.3",
    "ultracite": "8.3.1",
    "vitest": "^5.1.1"
  },
  "optionalDependencies": {
    "@esbuild/darwin-arm64": "^0.28.2",
    "@esbuild/darwin-x64": "^0.28.2",
    "@esbuild/linux-arm": "^0.28.2",
    "@esbuild/linux-arm64": "^0.28.2",
    "@esbuild/linux-ia32": "^0.28.2",
    "@esbuild/linux-loong64": "^0.28.2",
    "@esbuild/linux-mips64el": "^0.28.2",
    "@esbuild/linux-ppc64": "^0.28.2",
    "@esbuild/linux-riscv64": "^0.28.2",
    "@esbuild/linux-s390x": "^0.28.2",
    "@esbuild/linux-x64": "^0.28.2",
    "@esbuild/netbsd-arm64": "^0.28.2",
    "@esbuild/netbsd-x64": "^0.28.2",
    "@esbuild/openbsd-arm64": "^0.28.2",
    "@esbuild/openbsd-x64": "^0.28.2",
    "@esbuild/sunos-x64": "^0.28.2",
    "@esbuild/win32-arm64": "^0.28.2",
    "@esbuild/win32-ia32": "^0.28.2",
    "@esbuild/win32-x64": "^0.28.2"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "lefthook@2.2.2": true
  }
}
