{
  "name": "@frakment/site",
  "version": "0.0.1",
  "private": true,
  "description": "A component registry for React. Copy-paste primitives with motion built in. MIT.",
  "license": "MIT",
  "author": "The Frakment Authors (https://github.com/arrafipd/frakment)",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "assets:generate": "npm run assets:generate -w @frakment/web",
    "assets:install": "npm run assets:install -w @frakment/web",
    "prebuild": "node scripts/workspaces.mjs build",
    "build": "npm run build -w @frakment/web",
    "changeset": "changeset",
    "precheck": "node scripts/workspaces.mjs build",
    "check": "ultracite check",
    "predev": "node scripts/workspaces.mjs build",
    "dev": "npm run dev -w @frakment/web",
    "fix": "ultracite fix",
    "prepare": "node scripts/install-hooks.mjs",
    "registry:audit": "npm run registry:audit -w @frakment/web",
    "registry:build": "npm run registry:build -w @frakment/web",
    "registry:validate": "npm run registry:validate -w @frakment/web",
    "release": "node scripts/workspaces.mjs build && changeset publish",
    "start": "npm run start -w @frakment/web",
    "pretest": "node scripts/workspaces.mjs build",
    "test": "npm run test -w @frakment/web && vitest run --config vitest.config.ts",
    "test:watch": "npm run test:watch -w @frakment/web",
    "pretypecheck": "node scripts/workspaces.mjs build",
    "typecheck": "npm run typecheck -w @frakment/web && npm run typecheck -w @frakment/native",
    "version:packages": "changeset version"
  },
  "overrides": {
    "deepmerge": "npm:@stackline/deepmerge@^1.1.0",
    "esbuild": "^0.28.1",
    "lightningcss": "1.30.1",
    "minimatch": "^11.0.1"
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.6",
    "lefthook": "^2.2.2",
    "lightningcss": "1.30.1",
    "typescript": "^5.9.3",
    "ultracite": "8.1.1"
  },
  "optionalDependencies": {
    "@esbuild/darwin-arm64": "^0.28.2",
    "@esbuild/darwin-x64": "^0.28.2",
    "@esbuild/linux-arm": "^0.28.2",
    "@esbuild/linux-arm64": "^0.28.2",
    "@esbuild/linux-ia32": "^0.28.2",
    "@esbuild/linux-loong64": "^0.28.2",
    "@esbuild/linux-mips64el": "^0.28.2",
    "@esbuild/linux-ppc64": "^0.28.2",
    "@esbuild/linux-riscv64": "^0.28.2",
    "@esbuild/linux-s390x": "^0.28.2",
    "@esbuild/linux-x64": "^0.28.2",
    "@esbuild/netbsd-arm64": "^0.28.2",
    "@esbuild/netbsd-x64": "^0.28.2",
    "@esbuild/openbsd-arm64": "^0.28.2",
    "@esbuild/openbsd-x64": "^0.28.2",
    "@esbuild/sunos-x64": "^0.28.2",
    "@esbuild/win32-arm64": "^0.28.2",
    "@esbuild/win32-ia32": "^0.28.2",
    "@esbuild/win32-x64": "^0.28.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "lefthook@2.2.2": true
  }
}
