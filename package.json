{
  "name": "@frakment/site",
  "version": "0.0.1",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "author": "The Frakment Authors (https://github.com/arrafipd/frakment)",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "assets:generate": "node scripts/generate-assets.mjs",
    "assets:install": "npm i --no-save ffmpeg-static && npm rebuild ffmpeg-static",
    "prebuild": "npm run build --workspaces --if-present",
    "build": "cross-env NEXT_WORKER_THREADS=1 next build",
    "changeset": "changeset",
    "precheck": "npm run build --workspaces --if-present",
    "check": "ultracite check",
    "predev": "npm run build --workspaces --if-present",
    "dev": "next dev",
    "fix": "ultracite fix",
    "postinstall": "fumadocs-mdx",
    "prepare": "lefthook install",
    "registry:audit": "node scripts/audit-registry.mjs",
    "registry:build": "node scripts/build-registry.mjs",
    "release": "npm run build --workspaces --if-present && changeset publish",
    "start": "next start",
    "pretest": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretypecheck": "npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit",
    "version:packages": "changeset version"
  },
  "overrides": {
    "deepmerge": "npm:@stackline/deepmerge@^1.1.0",
    "esbuild": "^0.28.1",
    "minimatch": "^11.0.1"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.167",
    "@frakment/ai": "workspace:*",
    "@frakment/react": "workspace:*",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@number-flow/react": "^0.6.2",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "@web-kits/audio": "^0.2.0",
    "ai": "^7.0.159",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fumadocs-core": "^16.18.0",
    "fumadocs-mdx": "^15.5.0",
    "fumadocs-ui": "^16.18.0",
    "input-otp": "^1.5.0",
    "jiti": "^2.7.0",
    "jotai": "^3.0.1",
    "lru-cache": "^11.5.3",
    "lucide-react": "^1.70.0",
    "marked": "^18.1.2",
    "motion": "^14.10.0",
    "next": "^16.4.3",
    "next-themes": "0.4.6",
    "postcss": "^8.5.32",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hotkeys-hook": "^5.3.3",
    "react-markdown": "^10.1.0",
    "rehype-pretty-code": "^0.14.6",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "ts-morph": "^28.0.0",
    "use-stick-to-bottom": "^1.1.6",
    "vaul": "^1.1.2",
    "web-haptics": "^0.0.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@changesets/cli": "^2.27.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cross-env": "^10.1.0",
    "lefthook": "^2.2.2",
    "playwright": "^1.65.0",
    "rehype-highlight": "^7.0.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "ultracite": "8.1.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "lefthook@2.2.2": true
  }
}
